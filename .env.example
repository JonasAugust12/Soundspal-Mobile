

# ---- API ----
EXPO_PUBLIC_API_BASE_URL=https://api.soundspal.com/api/v1

# Endpoint refresh token.
# LƯU Ý: đang trỏ domain CŨ (talentlink.io.vn) trong khi API_BASE_URL đã sang soundspal.
# Nếu backend auth cũng đã chuyển, đổi thành: https://api.soundspal.com/api/v1/auth/refresh
EXPO_PUBLIC_AUTH_REFRESH_URL=https://talentlink.io.vn/api/v1/auth/refresh

# ---- Realtime ----
EXPO_PUBLIC_SOCKET_URL=https://api.soundspal.com
EXPO_PUBLIC_SOCKET_PATH=/socket.io

# ---- Google Sign-In ----
# OAuth client loại "Web application", phải trùng client_id backend dùng để đổi serverAuthCode.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=41xxxxxxxx-58io8pdnh0e0ngcd7v94cf4icprgpf4l.apps.googleusercontent.com

# ---- Local storage (MMKV) ----
# CẢNH BÁO: đổi 2 giá trị này trên bản đã release sẽ làm user mất dữ liệu local và bị đăng xuất.
EXPO_PUBLIC_STORAGE_ID=soundspal-xxxxx
EXPO_PUBLIC_STORAGE_ENCRYPTION_KEY=soundspal-xxxxx
